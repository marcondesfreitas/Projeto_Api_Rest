datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Client {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  favorites Favorite[]
  createdAt DateTime   @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  productId Int
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  createdAt DateTime @default(now())

  @@unique([clientId, productId])
}